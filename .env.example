PHISHSHIELD_DB_PATH=./data/phishshield.sqlite3
PHISHSHIELD_HOST=127.0.0.1
PHISHSHIELD_PORT=8000

# Exact frontend origins, comma separated; GitHub Pages project-site origin has no repository path.
PHISHSHIELD_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://ayushkp930.github.io

# Local developer convenience. On a public backend, keep these false until durable anti-abuse controls are deployed.
PHISHSHIELD_NETWORK_METADATA_ENABLED=true
PHISHSHIELD_INSPECT_ENABLED=true
PHISHSHIELD_INSPECT_LIMIT=8
PHISHSHIELD_INSPECT_WINDOW_SECONDS=600
PHISHSHIELD_REPUTATION_ENABLED=true
PHISHSHIELD_REPUTATION_LIMIT=6
PHISHSHIELD_REPUTATION_WINDOW_SECONDS=600
PHISHSHIELD_WHOIS_ENABLED=true
PHISHSHIELD_WHOIS_LIMIT=15
PHISHSHIELD_WHOIS_WINDOW_SECONDS=600
PHISHSHIELD_FULL_LIMIT=3
PHISHSHIELD_FULL_WINDOW_SECONDS=600

# Backend secrets ONLY. Never put real values in docs/assets/app.js or any GitHub Pages file.
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_WEB_RISK_API_KEY=
ABUSEIPDB_API_KEY=
